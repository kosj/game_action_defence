; Engine configuration file.
; Godot 4.x — Zombie Buster (Mobile WebGL)
; 에디터에서 한 번 열면 uid 등이 자동 채워집니다.

config_version=5

[application]

config/name="Zombie Buster"
run/main_scene="res://scenes/TitleScreen.tscn"
config/features=PackedStringArray("4.1", "GL Compatibility")

; 프레임 상한 60. 물리가 60Hz 이고 이 엔진 설정에는 2D 물리 보간이 없어, 좀비·총알·플레이어의
; 위치는 초당 60번만 갱신된다 — 그보다 빨리 렌더해도 같은 그림을 다시 그릴 뿐이라 얻는 게 없다.
; 120Hz 단말에서 발열·배터리만 쓰고 프레임 페이싱도 불규칙해지므로 상한을 명시한다.
; (0 = 무제한. vsync 는 기본값 유지 — 표시 주사율이 60 미만이면 그쪽이 먼저 걸린다)
run/max_fps=60

; 최초 구동 시 고도 엔진 로고(부팅 스플래시) 이미지를 숨긴다 — 배경색만 잠깐 보이고 바로 게임으로.
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 1)

[autoload]

Events="*res://scripts/Events.gd"
Pool="*res://scripts/Pool.gd"
GameData="*res://scripts/data/GameData.gd"
SoundManager="*res://scripts/SoundManager.gd"
SaveManager="*res://scripts/SaveManager.gd"
MetaManager="*res://scripts/MetaManager.gd"
RewardInbox="*res://scripts/RewardInbox.gd"
CharacterManager="*res://scripts/CharacterManager.gd"
AchievementManager="*res://scripts/AchievementManager.gd"
QuestManager="*res://scripts/QuestManager.gd"
ThemeManager="*res://scripts/ThemeManager.gd"
RankingManager="*res://scripts/RankingManager.gd"
AdManager="*res://scripts/AdManager.gd"
Locale="*res://scripts/Locale.gd"
UITheme="*res://scripts/UITheme.gd"
Cheats="*res://scripts/Cheats.gd"
Telemetry="*res://scripts/Telemetry.gd"
SceneFade="*res://scripts/SceneFade.gd"
CodexManager="*res://scripts/CodexManager.gd"
ThreatManager="*res://scripts/ThreatManager.gd"

[gui]

; 전역 기본 폰트를 엔진 레벨에서 CJK 폰트로 지정 — 씬 로드 이전에 적용되므로 웹 빌드에서도
; 모든 라벨/버튼에 한글·일본어가 정상 렌더된다. (런타임 root.theme 의 default_font 는 웹에서
; 적용이 누락돼, 폰트 오버라이드를 쓰지 않은 일반 라벨/버튼의 CJK 글리프가 깨지던 문제 해결.)
theme/custom_font="res://assets/fonts/NotoSansCJK-Subset.otf"

[display]

; 모바일 세로 화면 기준 (필요시 가로로 바꾸세요)
window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
; keep: 720x1280 전체가 항상 보이도록 레터박스(웹/데스크톱 등 다른 화면비에서 화면 잘림 방지).
window/stretch/aspect="keep"
window/handheld/orientation="portrait"

[input_devices]

; 데스크톱(에디터/브라우저)에서 마우스로 터치를 흉내 → 조이스틱 테스트 가능
pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[internationalization]

; 한글(CJK) 렌더링을 위해 FreeType/HarfBuzz 텍스트 서버 사용
; TextServerFallback은 CJK 글리프를 지원하지 않음
rendering/text_driver="ICU / HarfBuzz / FreeType"

[rendering]

; WebGL/모바일 호환을 위해 반드시 Compatibility 렌더러 사용
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[physics]

; 프레임이 늦어졌을 때 물리를 몰아서 여러 번 돌리면(기본 8회) 저사양 웹에서 "따라잡기 →
; 더 느려짐"의 악순환(death spiral)에 빠진다. 4회로 제한해 그 경우 물리를 늦추는 쪽을 택한다.
; 주의: physics_ticks_per_second 는 60 을 유지한다 — 좀비·총알·플레이어가 모두
; _physics_process 에서 이동하고 이 엔진 설정에는 2D 물리 보간이 없어, 30 으로 낮추면
; 연산은 절반이 되지만 화면 움직임도 30fps 로 보인다(실측 후 판단할 항목).
common/max_physics_steps_per_frame=4

[importer_defaults]

; 텍스처 기본 임포트 설정 — 웹 pck 는 전량 다운로드해야 첫 프레임이 뜨므로 텍스처 용량이
; 곧 초기 로딩 시간이다. 무손실(기본값 0) 대신 손실 압축(1=Lossy/WebP)을 기본으로 쓴다.
; .import 파일은 .gitignore 대상이라 CI 가 매 빌드 재생성하는데, 그때 이 기본값이 적용된다.
; lossy_quality 는 기본 0.7 보다 훨씬 높은 0.95 — 실측상 0.85 대비 용량은 0.6MB 늘지만
; 평균 오차가 줄어(MAE 1.55→1.05 / 255) 아이콘·스프라이트 경계 아티팩트 위험이 낮아진다.
; 나인패치로 늘려 쓰는 assets/ui/frames·hud 텍스처는 예외로 무손실(.import 를 저장소에 고정).
texture={
"compress/mode": 1,
"compress/lossy_quality": 0.95
}

[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="zombies"
2d_physics/layer_3="bullets"
2d_physics/layer_4="gold"
